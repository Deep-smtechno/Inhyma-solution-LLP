{% extends "layout.njk" %}
{% from "public/_macros.njk" import banner %}

{% block content %}
{{ banner('Contact Us', 'Have questions? Reach out to our team for personalized guidance.', [{label:'Contact'}]) }}

<section class="section">
  <div class="container">
    <div class="contact-info-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px, 100%), 1fr));gap:var(--space-6);margin-bottom:var(--space-12);">
      <a href="tel:{{ settings.phone }}" class="contact-info-card reveal"><div class="contact-info-card__icon contact-info-card__icon--blue">📞</div><div class="contact-info-card__text"><strong>Call Us</strong><p>{{ settings.phone }}</p></div></a>
      <a href="mailto:{{ settings.email }}" class="contact-info-card reveal"><div class="contact-info-card__icon contact-info-card__icon--orange">✉️</div><div class="contact-info-card__text"><strong>Email Us</strong><p>{{ settings.email }}</p></div></a>
      <a href="https://wa.me/{{ settings.whatsapp }}" class="contact-info-card reveal" target="_blank"><div class="contact-info-card__icon contact-info-card__icon--green"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.521-.075-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.36.101 11.943c0 2.105.549 4.16 1.595 5.975L0 24l6.335-1.652a11.882 11.882 0 005.71 1.447h.005c6.585 0 11.946-5.36 11.949-11.944a11.86 11.86 0 00-3.479-8.402"/></svg></div><div class="contact-info-card__text"><strong>WhatsApp</strong><p>Chat with us</p></div></a>
    </div>

    <div class="contact-grid" style="align-items:start; gap:var(--space-12);">
      <div>
        <h2 class="section-title" style="text-align:left;font-size:var(--fs-2xl);">Our Locations</h2>
        <div class="contact-info-card" style="flex-direction:column;gap:var(--space-4);align-items:flex-start;margin-bottom:var(--space-6);">
          <h3 style="font-size:var(--fs-base);margin:0;color:var(--color-primary);font-weight:var(--fw-semibold);">Headquarters & Main Warehouse</h3>
          <p style="margin:0;">📍 {{ settings.address }}</p>
          <p style="margin:0;">📞 <a href="tel:{{ settings.phone }}" style="color:inherit;">{{ settings.phone }}</a></p>
          <p style="margin:0;">✉️ <a href="mailto:{{ settings.email }}" style="color:inherit;">{{ settings.email }}</a></p>
        </div>
        <div class="contact-info-card" style="flex-direction:column;gap:var(--space-4);align-items:flex-start;margin-bottom:var(--space-6);">
          <h3 style="font-size:var(--fs-base);margin:0;color:var(--color-primary);font-weight:var(--fw-semibold);">Chennai Warehouse</h3>
          <p style="margin:0;">📍 Stockarea W304, 461/2C, Puzhal Village, Puzhal Ambattur Road, Chennai - 600066</p>
        </div>
        <div class="contact-info-card" style="flex-direction:column;gap:var(--space-4);align-items:flex-start;margin-bottom:var(--space-6);">
          <h3 style="font-size:var(--fs-base);margin:0;color:var(--color-primary);font-weight:var(--fw-semibold);">Ahmedabad Warehouse</h3>
          <p style="margin:0;">📍 Plot Number 24, Opp. Bijal Business Centre, Near Radhe Complex, Near Aslali Circle Char Rasta, S.P. Ring Road, Ahmedabad - 382427(Gujarat)</p>
        </div>
        <div class="contact-info-card" style="flex-direction:column;gap:var(--space-4);align-items:flex-start;">
          <h3 style="font-size:var(--fs-base);margin:0;color:var(--color-primary);font-weight:var(--fw-semibold);">Indore Warehouse</h3>
          <p style="margin:0;">📍 S. R. Compound, 119 / 2, Lasudia Mouri, Dewas Naka, Indore, Madhya Pradesh – 452010</p>
        </div>
      </div>

      <div class="lead-form reveal">
        <h3 class="lead-form__title">Send Us a Message</h3>
        <p class="lead-form__subtitle">Fill out the form and our team will get back to you within 24 hours.</p>
        {% if sent %}<div class="alert" style="background:var(--color-success,#1ea97c);color:#fff;padding:var(--space-4);border-radius:var(--radius);margin-bottom:var(--space-4);">✓ Thank you! We'll contact you soon.</div>{% endif %}
        <form method="post" action="/contact">
          <div class="form-row">
            <div class="form-group"><label class="form-label">Full Name *</label><input class="form-input" name="name" required maxlength="160"></div>
            <div class="form-group"><label class="form-label">Company</label><input class="form-input" name="company" maxlength="200"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Mobile *</label><input class="form-input" name="mobile" required maxlength="40"></div>
            <div class="form-group"><label class="form-label">Email *</label><input type="email" class="form-input" name="email" required maxlength="160"></div>
          </div>
          <div class="form-group"><label class="form-label">Subject</label><input class="form-input" name="subject" maxlength="200"></div>
          <div class="form-group"><label class="form-label">Message</label><textarea class="form-textarea" name="message" rows="5" maxlength="2000"></textarea></div>
          <button class="btn btn--primary btn--lg" type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</section>
{% endblock %}
