{% extends "admin/layout.njk" %}
{% block content %}
<form method="post" action="/admin/settings">
  {% for groupName, rows in groups %}
  <div class="card" style="margin-bottom:20px;">
    <div class="card__header">
      <h2 style="text-transform:capitalize;">
        {% if groupName == 'analytics' %}Analytics & Tracking Scripts{% else %}{{ groupName }}{% endif %}
      </h2>
      {% if groupName == 'analytics' %}
        <span class="muted" style="font-size:12.5px;">Google Tag, Google Analytics, GTM, Meta Pixel & verification tags</span>
      {% endif %}
    </div>
    <div class="card__body">
      <div class="form-grid">
        {% for r in rows %}
        <div class="fg {{ 'fg--full' if r.SettingGroup in ['footer','hero','analytics'] or r.SettingKey in ['address','header_scripts','body_scripts'] }}">
          <label>{{ r.Label or r.SettingKey }}</label>
          {% if r.SettingKey in ['header_scripts', 'body_scripts'] %}
            <textarea name="settings[{{ r.SettingKey }}]" rows="6" maxlength="15000" style="font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size:12.5px; background:#f8fafc; line-height:1.5;" placeholder="<!-- Paste your {{ 'Google Tag (gtag.js) / GA4 / GTM head snippet' if r.SettingKey == 'header_scripts' else 'Google Tag Manager noscript body code' }} here -->">{{ r.SettingValue }}</textarea>
            <div class="hint">
              {% if r.SettingKey == 'header_scripts' %}
                Paste your Google Tag (<code>gtag.js</code>), Google Analytics, GTM head code, Search Console verification, or Meta Pixel. Injected inside <code>&lt;head&gt;</code> on all public pages.
              {% else %}
                Optional. Injected immediately after the opening <code>&lt;body&gt;</code> tag (e.g. for Google Tag Manager <code>&lt;noscript&gt;</code> fallback).
              {% endif %}
            </div>
          {% elif r.SettingGroup in ['footer','hero'] %}
            <textarea name="settings[{{ r.SettingKey }}]" rows="3" maxlength="1000">{{ r.SettingValue }}</textarea>
            <div class="hint">{{ r.SettingKey }}</div>
          {% elif r.SettingKey == 'address' %}
            <textarea name="settings[{{ r.SettingKey }}]" rows="3" maxlength="500">{{ r.SettingValue }}</textarea>
            <div class="hint">{{ r.SettingKey }}</div>
          {% else %}
            <input type="text" name="settings[{{ r.SettingKey }}]" value="{{ r.SettingValue }}" maxlength="200">
            <div class="hint">{{ r.SettingKey }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endfor %}
  <button class="btn btn-primary" type="submit">Save All Settings</button>
</form>
{% endblock %}
